{
  "name": "tic-tac-three",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite --host 0.0.0.0 --port 5173\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "build:web": "vite build",
    "build:exe": "vite build && electron-builder --win --x64 --publish=never",
    "build:exe:all": "vite build && electron-builder --win --linux --x64 --publish=never",
    "build:exe:portable": "vite build && electron-builder --win portable --x64 --publish=never"
  },
  "build": {
    "appId": "com.tictacthree.game",
    "productName": "TIC TAC THREE",
    "electronVersion": "30.5.1",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "icon.png"
    ],
    "directories": {
      "buildResources": "."
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "electron": "30.5.1",
    "electron-builder": "24.9.1",
    "vite": "5.4.0",
    "wait-on": "7.2.0"
  }
}
